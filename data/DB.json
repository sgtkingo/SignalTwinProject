          "value": 40,
          "unit": "%",
          "dtype": "int",
          "restrictions": {
            "min": 0,
            "max": 100,
            "step": 5
          }
        }
      },
      "allowedPins": [3, 5, 6, 9, 10, 11],
      "default": {
        "configs": {
          "Enabled": "1",
          "Brightness": 40
        },
        "pins": ""
      }
