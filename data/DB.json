        "peak": { "value": 0.0, "unit": "dBm", "dtype": "float" }
      },
      "configs": {},
      "default": {
        "values": {
          "dBFS": 0.0,
          "peak": 0.0
        },
        "pins": ""
      }
    },
    "cam_001": {
      "uid": "cam_001",
      "role": "sensor",
